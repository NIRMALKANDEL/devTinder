MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/devTinder
JWT_SECRET=<a-long-random-string>
PORT=7777
FRONTEND_URL=http://localhost:5173

# AWS SES (IAM user needs ses:SendEmail on the sender identity)
AWS_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=<access-key-id>
AWS_SES_SECRET_ACCESS_KEY=<secret-access-key>
SES_FROM_EMAIL=no-reply@<your-verified-domain>
# Optional: SES configuration set for bounce/complaint/delivery events
SES_CONFIGURATION_SET=
# Optional, dev only: send every email to this address instead of the real user
EMAIL_DEMO_RECIPIENT=

# Email queue (optional, defaults shown). Keep EMAIL_MAX_SEND_RATE at or below
# the SES MaxSendRate divided by the number of running app instances.
EMAIL_MAX_SEND_RATE=10
EMAIL_CONCURRENCY=5
EMAIL_MAX_ATTEMPTS=4
# Set to false on dev machines that point at the production database
ENABLE_CRON=true

# Proxies in front of the API: nginx = 1 (Cloudflare adds the visitor IP header).
# Wrong value = rate limits shared by every user, or a spoofable client IP.
TRUST_PROXY=1
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
# Optional: where user reports are emailed
REPORTS_EMAIL=
# Local/test only: log emails instead of sending them
EMAIL_DRY_RUN=false

# Premium (Razorpay). Price in paise: 10000 = ₹100. Leave PREMIUM_PRICE_PAISE empty
# to keep checkout switched off ("price to be confirmed").
PREMIUM_PRICE_PAISE=10000
PREMIUM_DURATION_DAYS=30
# Dashboard -> Account & Settings -> API Keys (rzp_test_... for test mode, rzp_live_... for live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> the secret you typed when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Calls (WebRTC). STUN is free; TURN relays media on networks that block
# direct connections. Use EITHER TURN_SECRET (coturn use-auth-secret) OR
# TURN_USERNAME + TURN_CREDENTIAL (hosted TURN provider).
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.<your-domain>:3478?transport=udp,turn:turn.<your-domain>:3478?transport=tcp,turns:turn.<your-domain>:5349?transport=tcp
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=3600
# true = all media through TURN, so users never see each other's IP address
CALL_FORCE_RELAY=false
